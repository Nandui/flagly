// Flagly — Incident Reporting · Part of the Centrely Suite
// Stack: Prisma + PostgreSQL (Neon on Vercel)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon on Vercel injects a pooled DATABASE_URL and a direct DATABASE_URL_UNPOOLED.
  // Migrations use the direct connection; the app uses the pooled one.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── CENTRELY CORE ────────────────────────────────────────────────────────────
// Shared models from the Centrely suite. Flagly reuses Center and User exactly as
// Riskly and Staffly do — same database, same auth, same shell.

model Center {
  id        String   @id @default(cuid())
  name      String
  siteCode  String?  @unique // 2-letter code, e.g. "LW" -> INC-LW-0001
  region    Region   @default(IRELAND)
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents Incident[]
  areas     Area[]
  users     User[]

  @@index([siteCode])
}

enum Region {
  IRELAND          // Republic of Ireland
  NORTHERN_IRELAND // Northern Ireland
  GREAT_BRITAIN    // Great Britain
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         String   @default("Duty Manager") // Operations Manager | CEO | Duty Manager | Shift Supervisor | Department Supervisor
  centerId     String?
  center       Center?  @relation(fields: [centerId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([centerId])
}

// ─── FLAGLY ──────────────────────────────────────────────────────────────────

model Incident {
  id              String           @id @default(cuid())
  centerId        String
  center          Center           @relation(fields: [centerId], references: [id])
  reference       String           @unique // INC-LW-0001
  type            IncidentType
  status          IncidentStatus   @default(DRAFT)
  severity        IncidentSeverity
  occurredAt      DateTime // exact date + time of the incident
  // Structured location: an Area (and optional SubArea) within the centre.
  // `location` / `locationDetail` are denormalised copies of their names so
  // lists, the dashboard and exports never need to join, and survive deletes.
  areaId          String?
  area            Area?            @relation(fields: [areaId], references: [id], onDelete: SetNull)
  subAreaId       String?
  subArea         SubArea?         @relation(fields: [subAreaId], references: [id], onDelete: SetNull)
  location        String // denormalised Area name
  locationDetail  String? // denormalised SubArea name
  description     String // full narrative of what happened
  immediateAction String? // what was done at the time
  reportedBy      String // name of person completing the report
  reportedById    String? // User.id if the reporter is a system user
  witnessCount    Int              @default(0) // denormalised for display
  injuredCount    Int              @default(0) // denormalised for display
  closedAt        DateTime?
  closedBy        String?
  closureNotes    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  witnesses       Witness[]
  injuredParties  InjuredParty[]
  followUpActions FollowUpAction[]

  @@index([centerId])
  @@index([status])
  @@index([severity])
  @@index([occurredAt])
  @@index([areaId])
  @@index([subAreaId])
}

// ─── AREA / SUB-AREA ─────────────────────────────────────────────────────────
// A per-centre, two-level location taxonomy (Area → SubArea). Incidents are
// reported against an Area and, optionally, a SubArea within it.

model Area {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subAreas  SubArea[]
  incidents Incident[]

  @@unique([centerId, name])
  @@index([centerId])
}

model SubArea {
  id        String   @id @default(cuid())
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents Incident[]

  @@unique([areaId, name])
  @@index([areaId])
}

enum IncidentType {
  ACCIDENT // person injured
  NEAR_MISS // could have caused injury, did not
  PROPERTY_DAMAGE // damage to building, equipment, vehicles
  VIOLENCE_AGGRESSION // verbal or physical aggression
  HAZARDOUS_SUBSTANCE // chemical spill, exposure
  FIRE_OR_EVACUATION
  OTHER
}

enum IncidentStatus {
  DRAFT // being written, not yet submitted
  OPEN // submitted, awaiting investigation
  UNDER_INVESTIGATION
  CLOSED
}

enum IncidentSeverity {
  MINOR // first aid only, no lost time
  SIGNIFICANT // medical treatment, potential lost time
  REPORTABLE // serious enough to warrant external/management review
  CRITICAL // fatality or life-threatening
}

// ─── WITNESS ─────────────────────────────────────────────────────────────────

model Witness {
  id             String   @id @default(cuid())
  incidentId     String
  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  name           String
  roleOrRelation String // e.g. "Lifeguard", "Member", "Contractor"
  contactPhone   String?
  contactEmail   String?
  statement      String
  statementDate  DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([incidentId])
}

// ─── INJURED PARTY ───────────────────────────────────────────────────────────

model InjuredParty {
  id               String           @id @default(cuid())
  incidentId       String
  incident         Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  partyType        InjuredPartyType
  name             String
  contactPhone     String?
  contactEmail     String?
  address          String?
  dateOfBirth      DateTime?
  gender           String?
  injuryNature     String // e.g. "Laceration", "Fracture", "Suspected concussion"
  bodyPartAffected String // e.g. "Left forearm", "Head"
  treatment        TreatmentGiven
  hospitalName     String? // if HOSPITAL_AE or HOSPITAL_ADMITTED
  gpReferral       Boolean          @default(false)
  lostTime         Boolean          @default(false)
  lostTimeDays     Int?
  additionalNotes  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([incidentId])
}

enum InjuredPartyType {
  STAFF
  MEMBER
  CONTRACTOR
  VISITOR
  PUBLIC
}

enum TreatmentGiven {
  NONE
  FIRST_AID_ONLY
  GP_REFERRAL
  HOSPITAL_AE
  HOSPITAL_ADMITTED
}

// ─── FOLLOW-UP ACTION ────────────────────────────────────────────────────────

model FollowUpAction {
  id          String       @id @default(cuid())
  incidentId  String
  incident    Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  description String
  assignedTo  String // free text name in v1
  dueDate     DateTime
  status      ActionStatus @default(OPEN)
  completedAt DateTime?
  completedBy String?
  notes       String       @default("")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([incidentId])
  @@index([status])
  @@index([dueDate])
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETE
  OVERDUE // computed from dueDate, but stored to enable efficient queries
}
