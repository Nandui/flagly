# Postgres connection (Neon on Vercel). Use the POOLED connection string here.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) connection, used only for migrations.
# On Vercel's Neon integration this is injected automatically as DATABASE_URL_UNPOOLED.
# Locally you can set it to the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# next-auth v5 — generate with: npx auth secret   (or any 32-byte base64 string)
AUTH_SECRET="generate-with: npx auth secret"
AUTH_TRUST_HOST="true"
